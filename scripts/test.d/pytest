# SPDX-License-Identifier: Apache-2.0
#
# pytest, from this repository's own .venv. Extra arguments are passed
# through. See CONTRIBUTING.md ("Repository layout").
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"

if [ ! -x "$venv/bin/python" ]; then
  echo "test.d/pytest: no .venv found. Create it first: python3.13 -m venv .venv && .venv/bin/pip install -e . --group dev (see README)." >&2
  exit 1
fi

cd "$root"
exec "$venv/bin/python" -m pytest "$@"
