#
# reuse lint, from this repository's own .venv. Extra arguments are
# passed through.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"

if [ ! -x "$venv/bin/reuse" ]; then
  echo "lint.d/reuse: no .venv found. Create it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

cd "$root"
exec "$venv/bin/reuse" lint "$@"
