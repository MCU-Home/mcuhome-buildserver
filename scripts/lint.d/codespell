#
# codespell, from this repository's own .venv. The ignored-words list and
# the skipped paths live in [tool.codespell] in pyproject.toml, so this
# wrapper runs the plain tool. Extra arguments are passed through.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"

if [ ! -x "$venv/bin/codespell" ]; then
  echo "lint.d/codespell: no .venv found. Create it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

cd "$root"
exec "$venv/bin/codespell" "$@"
